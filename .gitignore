Server/server.pid
Server/__pycache__/
__pycache__/
*.pyc

# 数据存档（本地对局数据，不入库）
Server/data/
*.db
*.db-wal
*.db-shm

# 工具缓存
.playwright-cli/

# 本地输出产物（截图/生成物，不入库）
output/

