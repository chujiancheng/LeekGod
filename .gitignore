# 依赖
node_modules/

# 运行时产物
Server/log/
Server/server.log*
Server/server.*.log*
Server/server-console.log*
Server/server.pid
Server/__pycache__/
__pycache__/
*.pyc

# 数据存档（本地对局数据，不入库）
Server/data/
*.db
*.db-wal
*.db-shm

# 工具缓存
.playwright-cli/

# 本地输出产物（截图/生成物，不入库）
output/

# 带 Key 的本地批处理副本（run-quant.bat 本身入库，run-quant-ma.bat 之类自己存的别入库）
Server/examples/run-quant-*.bat

# 带真实 Key 的本地示例脚本：examples/ 整体不入库（远端只放 API_KEY = "" 的空壳），
# 三个已跟踪的 .py 靠 skip-worktree 挡着，未跟踪的 quant_grid.py 交给这里挡。
Server/examples/quant_grid.py

# 设计稿画布（AI 出图的迭代底稿 + 素材副本，正式立绘已进 Client/img，不入库）
*.miora
*_assets/

# 出图高分辨率母版（正式图已压到 Client/img，母版本地留档不入库；art 下的生成脚本要入库）
art/**/*.png

# 智能体工作目录（记忆 + 临时产物，不入库）
.workbuddy/
generated-images/

# iOS：.xcodeproj 由 xcodegen 从 project.yml 现生成，构建产物不入库
iOS/LeekGod.xcodeproj/
iOS/build/
iOS/Payload/
iOS/*.ipa
iOS/build.log
iOS/DerivedData/
