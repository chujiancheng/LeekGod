<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色免白屏：windowBackground 用 App 底色，启动瞬间不闪白 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:statusBarColor">@color/boot_bg</item>
        <item name="android:navigationBarColor">@color/boot_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
